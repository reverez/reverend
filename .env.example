# Optional overrides. Reverend otherwise discovers a local Ollama endpoint.
# Native Linux/macOS commonly uses localhost; WSL can discover the Windows gateway.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional runtime-state location. Keep it outside the source repository.
AI_DATA_ROOT=/home/you/.local/share/reverend

# Optional persistent runtime configuration instead of environment variables.
# REVEREND_RUNTIME_CONFIG=/home/you/.config/reverend/runtime.json

# Optional Qdrant server mode. Leave unset to use the embedded store under AI_DATA_ROOT.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=local_knowledge_v2

# Never commit QDRANT_API_KEY or other credentials.


# Optional bounded web-search provider. Search only runs when network policy allows it,
# and discovered pages are still fetched through Reverend's restricted public-research sandbox.
#
# Canonical free/local-first backend: self-hosted SearXNG.
# Start the bundled loopback-only profile with:
#   scripts/reverend-searxng up
# then:
#   eval "$(scripts/reverend-searxng env)"
#
# Manual SearXNG configuration (JSON output must be enabled):
# REVEREND_WEB_SEARCH_PROVIDER=searxng
# REVEREND_WEB_SEARCH_ENDPOINT=http://127.0.0.1:8888
#
# Optional alternative adapter: Brave Search (may require a paid provider plan).
# REVEREND_WEB_SEARCH_PROVIDER=brave
# REVEREND_WEB_SEARCH_API_KEY=replace-me
#
# Optional localization:
# REVEREND_WEB_SEARCH_COUNTRY=GB
# REVEREND_WEB_SEARCH_LANGUAGE=en
#
# Never commit REVEREND_WEB_SEARCH_API_KEY or BRAVE_SEARCH_API_KEY.
